#!/usr/bin/env node

const [,, command, target] = process.argv;

const validTargets = ['claude'];
const usage = 'Usage:\n  aiteam init claude\n  aiteam update claude';

function run(fn) {
  fn.catch(err => {
    const chalk = require('chalk');
    console.error(chalk.red('\nError: ' + err.message));
    process.exit(1);
  });
}

if (command === 'init' && target === 'claude') {
  const { main } = require('../src/cli');
  run(main('claude'));
} else if (command === 'update' && target === 'claude') {
  const { update } = require('../src/cli');
  run(update('claude'));
} else if ((command === 'init' || command === 'update') && target !== undefined) {
  console.error(`Unknown target "${target}". Currently only "claude" is supported.`);
  console.error(usage);
  process.exit(1);
} else {
  console.error(usage);
  process.exit(1);
}
